# Copy to .env and fill. NEVER commit .env.
# Only add a key when the agent actually needs that connection working.

# --- Meta (Facebook + Instagram): ads, page posts, IG posts, insights ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_TOKEN=
META_API_VERSION=v21.0
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_ID=
META_AD_ACCOUNT_ID=          # format: act_1234567890
META_ADS_TOKEN=

# --- Google: Ads + Search Console + Analytics ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GA4_PROPERTY_ID=

# --- Etsy: listings, shop stats, ads ---
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_TOKEN=
ETSY_OAUTH_REFRESH_TOKEN=

# --- OpenArt: image generation ---
OPENART_API_KEY=

# --- Higgsfield: image + video generation (used by the higgsfield-* skills) ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=

# --- Scheduler / publishing (pick one, delete the rest) ---
# Metricool, Buffer, Later, Postiz, or an approved automation webhook
SCHEDULER_PROVIDER=
SCHEDULER_API_KEY=
SCHEDULER_WEBHOOK_URL=

# --- Research (powers /last30days) ---
EXA_API_KEY=
APIFY_TOKEN=
